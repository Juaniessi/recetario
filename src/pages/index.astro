---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { leerArbol, nombreDeRama, colorDeRama } from '../lib/categorias.js';
import { ETIQUETAS, etiquetaIngrediente } from '../lib/receta.js';
import { normalizar } from '../lib/filtros.js';

const base = import.meta.env.BASE_URL;
const arbol = leerArbol();
const recetas = (await getCollection('recetas')).sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));

// Las sub-ramas se muestran solo si alguna receta las usa.
const usadas = new Set(recetas.flatMap((r) => r.data.categorias));
const ramas = arbol.map((r) => ({ ...r, sub: r.sub.filter((s) => usadas.has(s.id)) }));
// Arriba, junto a «Todas las recetas», las principales; el resto, para filtrar.
const principales = ramas.filter((r) => r.principal);
const otras = ramas.filter((r) => !r.principal);

const transversales = [
  { grupo: 'sabor', titulo: 'Dulce o salado', valores: Object.entries(ETIQUETAS.sabor) },
  { grupo: 'equipo', titulo: 'Equipo', valores: Object.entries(ETIQUETAS.equipo) },
];

// Los nombres de los ingredientes, para «Ingrediente» y para mostrar cuáles coinciden.
// Primero los ingredientes de verdad; al final, las etiquetas de ingrediente_principal,
// que sirven para encontrar una receta sin ingredientes cargados (las pendientes).
const realesDe = (r) => [...new Set(r.data.ingredientes.flatMap((g) => g.lista.map((i) => i.nombre)))];
const nombresDe = (r) => [...realesDe(r), ...r.data.ingrediente_principal.map(etiquetaIngrediente)];

// Lo que el buscador mira: título, ingredientes y etiquetas.
const textoDe = (r) =>
  normalizar(
    [
      r.data.titulo,
      ...r.data.ingredientes.flatMap((g) => g.lista.map((i) => i.nombre)),
      ...r.data.ingrediente_principal,
      ...r.data.categorias.map((c) => nombreDeRama(c, arbol)),
    ].join(' '),
  );
---

<Base>
  <input class="buscar" id="buscar" type="search" placeholder="Buscar: chocolate, paleta, harina…" autocomplete="off" />

  <div class="filtros">
    <div class="chips principales">
      <button class="chip principal todas" type="button" id="todas" aria-pressed="true">
        Todas las recetas <span class="n">{recetas.length}</span>
      </button>
      {principales.map((r) => (
        <button class={`chip principal c-${r.color}`} type="button" data-cat={r.id} aria-pressed="false">
          {r.nombre} <span class="n"></span>
        </button>
      ))}
    </div>
    {principales.filter((r) => r.sub.length).map((r) => (
      <div class={`sub-ramas chips c-${r.color}`} data-padre={r.id} hidden>
        {r.sub.map((s) => (
          <button class="chip" type="button" data-cat={s.id} aria-pressed="false">
            {s.nombre} <span class="n"></span>
          </button>
        ))}
      </div>
    ))}

    <div class="grupo-titulo filtrar">Filtrar por</div>
    <div>
      <div class="grupo-titulo">Más categorías</div>
      <div class="chips">
        {otras.map((r) => (
          <button class={`chip grande c-${r.color}`} type="button" data-cat={r.id} aria-pressed="false">
            {r.nombre} <span class="n"></span>
          </button>
        ))}
      </div>
    </div>
    {otras.filter((r) => r.sub.length).map((r) => (
      <div class={`sub-ramas chips c-${r.color}`} data-padre={r.id} hidden>
        {r.sub.map((s) => (
          <button class="chip" type="button" data-cat={s.id} aria-pressed="false">
            {s.nombre} <span class="n"></span>
          </button>
        ))}
      </div>
    ))}

    {transversales.map((t) => (
      <div>
        <div class="grupo-titulo">{t.titulo}</div>
        <div class="chips">
          {t.valores.map(([valor, nombre]) => (
            <button class="chip" type="button" data-grupo={t.grupo} data-valor={valor} aria-pressed="false">
              {nombre} <span class="n"></span>
            </button>
          ))}
        </div>
      </div>
    ))}

    <div>
      <label class="grupo-titulo" for="buscar-ing">Ingrediente</label>
      <input class="buscar ing" id="buscar-ing" type="search" placeholder="Escribí uno o varios: chocolate, coco…" autocomplete="off" />
    </div>
  </div>

  <div class="resumen">
    <span id="cuantas"></span>
  </div>

  {ramas.map((r) => (
    <p class="vacia" data-vacia={r.id} hidden>
      Todavía no hay recetas en {r.nombre}{r.aclaracion && ` (${r.aclaracion})`}.
    </p>
  ))}
  <p class="vacia" id="sin-resultados" hidden>Ninguna receta cumple todo lo elegido.</p>

  <ul class="tarjetas" id="tarjetas">
    {recetas.map((r) => (
      <li
        class={`tarjeta c-${colorDeRama(r.data.categorias[0], arbol)}`}
        data-cats={r.data.categorias.join(' ')}
        data-sabor={r.data.sabor}
        data-equipo={r.data.equipo.join(' ')}
        data-ingredientes={nombresDe(r).join('|')}
        data-reales={realesDe(r).length}
        data-texto={textoDe(r)}
      >
        <a href={`${base}${r.id}/`}>
          <span class="t">{r.data.titulo}</span>
          {r.data.estado !== 'final' && <span class="estado">{ETIQUETAS.estado[r.data.estado]}</span>}
          <span class="r" style="display:block">{r.data.categorias.map((c) => nombreDeRama(c, arbol)).join(' · ')}</span>
          <span class="lleva" hidden></span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<script>
  import { vacia, filtrar, contarRama, contarValor, alternar, leerSeleccion, escribirSeleccion, enRama, normalizar, ingredientesQueCoinciden } from '../lib/filtros.js';

  const tarjetas = [...document.querySelectorAll('.tarjeta')];
  const recetas = tarjetas.map((el) => {
    const nombres = el.dataset.ingredientes.split('|');
    return {
      el,
      nombres,
      cats: el.dataset.cats.split(' '),
      sabor: [el.dataset.sabor],
      equipo: el.dataset.equipo.split(' '),
      ingredientes: nombres.map(normalizar),
      texto: el.dataset.texto,
    };
  });
  const buscar = document.getElementById('buscar');
  const buscarIng = document.getElementById('buscar-ing');
  let sel = { ...vacia(), ...leerSeleccion(location.search) };
  buscar.value = sel.q;
  buscarIng.value = sel.ing;

  function pintar() {
    const quedan = new Set(filtrar(recetas, sel));
    for (const r of recetas) {
      r.el.hidden = !quedan.has(r);
      // Con un ingrediente escrito, la tarjeta dice cuáles de los suyos coincidieron.
      const lleva = r.el.querySelector('.lleva');
      const indices = sel.ing && quedan.has(r) ? ingredientesQueCoinciden(r, sel.ing) : null;
      lleva.hidden = !indices;
      if (indices) {
        // Se muestran los ingredientes de verdad; la etiqueta, solo si no hay otro.
        const reales = indices.filter((i) => i < Number(r.el.dataset.reales));
        lleva.textContent = `Lleva: ${(reales.length ? reales : indices).map((i) => r.nombres[i]).join(' · ')}`;
      }
    }

    const padre = sel.cat.split('/')[0];
    for (const b of document.querySelectorAll('[data-cat]')) {
      const cat = b.dataset.cat;
      const elegida = sel.cat === cat || (!cat.includes('/') && padre === cat);
      b.setAttribute('aria-pressed', String(elegida));
      const n = contarRama(recetas, sel, cat);
      b.querySelector('.n').textContent = n;
      // Las ramas grandes nunca se apagan: tocar una vacía muestra su aviso.
      b.disabled = cat.includes('/') && n === 0 && !elegida;
    }
    for (const fila of document.querySelectorAll('[data-padre]')) fila.hidden = fila.dataset.padre !== padre;

    for (const b of document.querySelectorAll('[data-grupo]')) {
      const { grupo, valor } = b.dataset;
      const elegido = sel[grupo].includes(valor);
      const n = contarValor(recetas, sel, grupo, valor);
      b.setAttribute('aria-pressed', String(elegido));
      b.querySelector('.n').textContent = n;
      b.disabled = n === 0 && !elegido;
    }

    const ramaVacia = padre && !recetas.some((r) => enRama(r, padre));
    for (const p of document.querySelectorAll('[data-vacia]')) p.hidden = !(ramaVacia && p.dataset.vacia === padre);
    document.getElementById('sin-resultados').hidden = quedan.size > 0 || ramaVacia;

    const hayAlgo = escribirSeleccion(sel) !== '';
    document.getElementById('cuantas').textContent = hayAlgo
      ? `${quedan.size} de ${recetas.length} recetas`
      : `${recetas.length} recetas`;
    document.getElementById('todas').setAttribute('aria-pressed', String(!hayAlgo));
    history.replaceState(null, '', location.pathname + escribirSeleccion(sel));
  }

  document.addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    if (b.dataset.cat !== undefined) {
      const cat = b.dataset.cat;
      // Tocar lo que ya está elegido lo suelta (una sub-rama vuelve a su rama).
      if (sel.cat === cat) sel.cat = cat.includes('/') ? cat.split('/')[0] : '';
      else sel.cat = cat;
    } else if (b.dataset.grupo) {
      sel[b.dataset.grupo] = alternar(sel[b.dataset.grupo], b.dataset.valor);
    } else if (b.id === 'todas') {
      sel = vacia();
      buscar.value = '';
      buscarIng.value = '';
    } else return;
    pintar();
  });
  buscar.addEventListener('input', () => {
    sel.q = buscar.value.trim();
    pintar();
  });
  buscarIng.addEventListener('input', () => {
    sel.ing = buscarIng.value.trim();
    pintar();
  });
  pintar();
</script>
